{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowSyntheticDefaultImports": true,
    // Override the root source aliases so Playwright loads the built packages.
    "paths": {
      "@fabricjs/aligning-guidelines": ["../aligning-guidelines/dist/index"],
      "@fabricjs/browser": ["../browser/dist/index"],
      "@fabricjs/core": ["../core/dist/index"],
      "@fabricjs/cropping-controls": ["../cropping-controls/dist/index"],
      "@fabricjs/data-updaters": ["../data-updaters/dist/index"],
      "@fabricjs/gradient-controls": ["../gradient-controls/dist/index"],
      "@fabricjs/node": ["../node/dist/index"],
      "@fabricjs/westures-integration": ["../westures-integration/dist/index"],
      "fabric": ["../../dist/index"],
      "fabric/extensions": ["../../dist-extensions/extensions/index"],
      "fabric/node": ["../../dist/index.node"]
    },
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "env.d.ts"],
  "exclude": []
}
