{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmitOnError": false,
    "allowJs": false
  },
  "include": [
    "index.ts",
    "index.node.ts",
    "index.skia.ts",
    "packages/skia/src/jsdom.d.ts"
  ],
  "exclude": [
    "dist",
    "dist-extensions",
    "node_modules",
    "**/*.mjs",
    "**/*.js",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.fixtures.ts"
  ]
}
