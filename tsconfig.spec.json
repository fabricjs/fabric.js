{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@vitest/browser/providers/playwright"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "fabric": ["./src"],
      "fabric/node": ["./src/node"],
      "fabric/extensions": ["./extensions"],
      "@fabricjs/core": ["./fabric"],
      "@fabricjs/browser": ["./packages/browser/src/index"],
      "@fabricjs/gradient-controls": ["./packages/gradient-controls/src/index"],
      "@fabricjs/node": ["./packages/node/src/index"]
    }
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "extensions/**/*",
    "packages/*/src/**/*",
    "vitest.d.ts",
    "vitest.env.d.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "vitest.extend.ts",
    "playwright.setup.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "dist-extensions", "e2e", "test"]
}
