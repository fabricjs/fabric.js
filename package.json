{
  "name": "fabric",
  "description": "Object model for HTML5 canvas, and SVG-to-canvas parser. Backed by jsdom and node-canvas.",
  "homepage": "http://fabricjs.com/",
  "version": "7.5.0-beta.1",
  "author": "Juriy Zaytsev <kangax@gmail.com>",
  "contributors": [
    {
      "name": "Andrea Bogazzi",
      "email": "andreabogazzi79@gmail.com",
      "url": "https://github.com/asturur"
    },
    {
      "name": "Shachar Nencel",
      "email": "shacharnen@gmail.com",
      "url": "https://github.com/ShaMan123"
    },
    {
      "name": "Steve Eberhardt",
      "email": "melchiar2@gmail.com",
      "url": "https://github.com/melchiar"
    }
  ],
  "keywords": [
    "canvas",
    "graphic",
    "graphics",
    "SVG",
    "node-canvas",
    "parser",
    "HTML5",
    "object model"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabricjs/fabric.js.git"
  },
  "bugs": {
    "url": "https://github.com/fabricjs/fabric.js/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "dist-extensions",
    "extensions/README.MD",
    "!extensions/**/*.ts"
  ],
  "packageManager": "pnpm@11.28.10",
  "scripts": {
    "docs": "typedoc --tsconfig typedoc.config.json",
    "cli": "node ./scripts/index.mjs",
    "sandboxscript": "node ./scripts/sandbox.mjs",
    "typecheck": "tsc -p ./tsconfig.build.json --noEmit && tsc -p ./tsconfig-extensions.json --noEmit && tsc -p ./tsconfig.packages.json --noEmit && pnpm run typecheck:spec",
    "typecheck:spec": "tsc -p ./tsconfig.spec.json --noEmit --incremental --tsBuildInfoFile ./node_modules/.cache/tsc/spec.tsbuildinfo",
    "build": "node ./scripts/index.mjs build",
    "build:clean": "pnpm run clean:dist && pnpm run build",
    "build:fast": "node ./scripts/index.mjs build -f",
    "clean:dist": "node ./scripts/clean-dist.mjs",
    "smoke:packages": "node ./scripts/package-smoke.mjs",
    "dev": "node ./scripts/index.mjs dev",
    "start": "node ./scripts/sandbox.mjs start",
    "test:vitest": "vitest --run --project unit-node",
    "test:vitest:chromium": "vitest --run --project unit-chromium",
    "test:vitest:firefox": "vitest --run --project unit-firefox",
    "test:vitest:all": "vitest --run",
    "test:vitest:coverage": "vitest --run --coverage --project unit-node",
    "test:vitest:coverage:watch": "pnpm run test:vitest --coverage=true",
    "test:e2e": "pnpm run build && pnpm run playwright:typecheck && pnpm --dir packages/e2e run test",
    "playwright:typecheck": "pnpm --dir packages/e2e run typecheck",
    "sandbox": "node ./scripts/sandbox.mjs sandbox",
    "versionbump": "node ./scripts/versionbump.mjs",
    "lint": "oxlint extensions packages",
    "lint:fix": "oxlint --fix extensions packages",
    "prettier:check": "oxfmt --check .",
    "prettier:write": "oxfmt .",
    "web-dev": "pnpm run build && node ./scripts/index.mjs build -f -w & pnpm --dir packages/website run dev; kill $!",
    "prepare": "husky install",
    "test:vitest:skia": "vitest --run --project unit-skia",
    "test:e2e:skia": "pnpm run build && pnpm run playwright:typecheck && FABRIC_TEST_BACKEND=skia pnpm --dir packages/e2e test tests/visual-output/rendering"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "commander": "15.0.0",
    "es-toolkit": "1.52.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "oxfmt": "0.75.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2005",
    "picomatch": "4.0.7",
    "rolldown": "1.2.9",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vitest": "5.1.0",
    "westures": "catalog:"
  },
  "dependencies": {
    "@fabricjs/aligning-guidelines": "workspace:^",
    "@fabricjs/browser": "workspace:^",
    "@fabricjs/cropping-controls": "workspace:^",
    "@fabricjs/data-updaters": "workspace:^",
    "@fabricjs/gradient-controls": "workspace:^",
    "@fabricjs/westures-integration": "workspace:^"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "canvas": {
      "canvas": "3.2.0"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    ">=4.2": {
      "*": [
        "dist/index.d.ts"
      ],
      "node": [
        "dist/index.node.d.ts"
      ],
      "skia": [
        "dist/index.skia.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.min.mjs",
    "./dist/index.js",
    "./dist/index.min.js",
    "./dist/fabric.mjs",
    "./dist/fabric.min.mjs",
    "./dist/index.node.mjs",
    "./dist/index.node.cjs",
    "./dist/index.skia.mjs",
    "./dist/index.skia.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.min.mjs",
      "require": "./dist/index.min.js",
      "default": "./dist/index.min.js"
    },
    "./es": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fabric.min.mjs",
      "require": null,
      "default": null
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "import": "./dist/index.node.mjs",
      "require": "./dist/index.node.cjs",
      "node": "./dist/index.node.cjs",
      "default": "./dist/index.node.cjs"
    },
    "./extensions": {
      "node": "./dist-extensions/index.mjs",
      "types": "./dist-extensions/extensions/index.d.ts",
      "import": "./dist-extensions/index.mjs",
      "require": null,
      "default": "./dist-extensions/fabric-extensions.min.js"
    },
    "./skia": {
      "types": "./dist/index.skia.d.ts",
      "import": "./dist/index.skia.mjs",
      "require": "./dist/index.skia.cjs",
      "default": "./dist/index.skia.mjs"
    }
  },
  "optionalDependencies": {
    "@fabricjs/node": "workspace:^"
  },
  "peerDependencies": {
    "@fabricjs/skia": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@fabricjs/skia": {
      "optional": true
    }
  }
}
